# Application environment variables
APP_NAME="ЭнергоСбыт"
APP_VERSION=1.1.0
APP_PORT=8080
APP_HOST=0.0.0.0

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=energosbyt

# Docker
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.7
PYTHON_IMAGE=python:3.12-slim
UV_IMAGE=ghcr.io/astral-sh/uv:0.10.6
CLICKHOUSE_SKIP_USER_SETUP=1
TZ=UTC
CLICKHOUSE_HEALTHCHECK_RETRIES=60
APP_HEALTHCHECK_RETRIES=30
HEALTHCHECK_INTERVAL=2s
HEALTHCHECK_TIMEOUT=5s

# HTTP и загрузка
HTTP_TIMEOUT=60
MAX_REQUEST_BYTES=65536
DATA_DIR=data
VOLUME_DIR=./volume
LOAD_CHUNK_BYTES=8388608

# Генератор
GENERATOR_SEED=42
GENERATOR_OBJECTS=1000
GENERATOR_COMMERCIAL_STEP=10
GENERATOR_OBJECTS_PER_HOUSE=50
GENERATOR_SQUARE_MIN=30
GENERATOR_SQUARE_MAX=120
GENERATOR_ROOMS_MIN=1
GENERATOR_ROOMS_MAX=4
GENERATOR_FLOORS=10
GENERATOR_DAY_USAGE_MIN=3
GENERATOR_DAY_USAGE_MAX=12
GENERATOR_NIGHT_USAGE_MIN=1
GENERATOR_NIGHT_USAGE_MAX=5
GENERATOR_INVOICE_DEADLINE_DAY=10
GENERATOR_TARIFF_NAME="День–Ночь"
GENERATOR_GAUGE_NAME="Меркурий 200"
GENERATOR_REPLACEMENT_GAUGE_NAME="Меркурий 206"
GENERATOR_GAUGE_COUNTRY=Россия
GENERATOR_START_DATE=2023-11-01
GENERATOR_END_DATE=2026-10-31
GENERATOR_TARIFF_CHANGE_DATE=2025-11-01
GENERATOR_GAUGE_REPLACEMENT_DATE=2025-05-01
GENERATOR_OPEN_VERSION_DATE=2099-01-01
GENERATOR_REPLACEMENT_STEP=10
GENERATOR_GAUGE_OFFSET=1000
GENERATOR_CORRECTION_RATE=0.03
GENERATOR_CORRECTION_DELTA=10
GENERATOR_OLD_DAY_PRICE=550
GENERATOR_OLD_NIGHT_PRICE=250
GENERATOR_NEW_DAY_PRICE=620
GENERATOR_NEW_NIGHT_PRICE=310
